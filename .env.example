# backend/Back-reviews/.env.example
# ========================
# MODIFICADO
# ========================
# Copia este archivo a ".env" antes de correr el proyecto:
#   cp .env.example .env

# --- MongoDB ---
MONGO_USER=user
MONGO_PASSWORD=password
MONGO_DB_NAME=bookreviews

# --- Connection string para FastAPI ---
# Nota: el host 'mongodb' coincide con el nombre del servicio en docker-compose.yml
MONGODB_URL=mongodb://user:password@mongodb:27017

# --- Google Books API ---
GOOGLE_BOOKS_API_URL=https://www.googleapis.com/books/v1/volumes

SECRET_KEY=tu_clave_secreta_super_segura_debe_ser_larga
ALGORITHM=HS256

# ============================================
# THROTTLING CONFIGURATION
# ============================================
# Habilitar o deshabilitar throttling (true/false)
ENABLE_THROTTLING=true

# Nota: Los rate limits específicos están definidos en el código
# por endpoint (ver app/api/reviews.py):
# - POST /reviews/           : 10 req/min  (crear reseña)
# - GET /reviews/my-reviews  : 60 req/min  (mis reseñas)
# - PATCH /reviews/{id}      : 20 req/min  (actualizar)
# - DELETE /reviews/{id}     : 20 req/min  (eliminar)
# - POST /reviews/{id}/vote  : 30 req/min  (votar)
# - GET /reviews/book/{id}   : 100 req/min (reseñas de libro)
# - GET /reviews/users/{id}  : 60 req/min  (reseñas de usuario)

# =============================================================================
# CONFIGURACIÓN POR AMBIENTE
# =============================================================================
# Para DESARROLLO: Desactivar throttling
# ENABLE_THROTTLING=false

# Para PRODUCCIÓN: Activar throttling
# ENABLE_THROTTLING=true